<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, LangVersion and $(AvaloniaVersion) come from
       Directory.Build.props at the repository root. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Bindings are compiled against the x:DataType declared in the XAML: a mistyped
         property name is a build error instead of a binding that silently shows nothing,
         and no reflection runs when a value changes. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>SteamPipeStudio</AssemblyName>
    <RootNamespace>SteamPipeStudio.App</RootNamespace>
    <!-- Cross-platform publish targets. -->
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64;linux-x64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Compiled into the Windows executable, which is what Explorer, the taskbar and
         alt-tab read. It has no effect on the other targets, and none on the window's own
         icon at runtime — that is set in MainWindow from the AvaloniaResource below. -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <!-- Installer, portable build and self-update from GitHub Releases. No transitive
         packages on net10.0. Keep it in step with the vpk tool version in release.yml:
         the app and the packer agree on the package format. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the .ico is embedded. It carries every size from 16 to 256, so the window
         asks for the one it needs instead of downscaling a 256px bitmap into a 16px title
         bar. icon.svg is the editable master and icon-*.png are for Linux desktop entries
         and the README; neither belongs inside the binary. -->
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped next to the executable: the GPL asks for the license to travel with the
         program, and the bundled runtime, Avalonia, Skia, Velopack and the Inter font each
         ask for their own notice. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamPipeStudio.Core\SteamPipeStudio.Core.csproj" />
  </ItemGroup>

</Project>
